#!/usr/bin/env bash
# Warns (without blocking) if the commit message does not follow Conventional Commits:
#   type(scope)!: description      types: feat, fix, perf, docs, refactor, test, build, ci, chore, style, i18n
# `scripts/release.sh` derives the next version from it (feat -> minor, fix/perf -> patch, ! -> breaking).
set -euo pipefail
subject=$(head -n1 "$1")
case "$subject" in
    Merge\ * | Revert\ * | fixup\!\ * | squash\!\ * | amend\!\ *) exit 0 ;;
esac
re='^(feat|fix|perf|docs|refactor|test|build|ci|chore|style|i18n)(\([^)]+\))?!?: .+'
if ! [[ "$subject" =~ $re ]]; then
    {
        echo "[commit-msg] attention : « $subject »"
        echo "             ne suit pas « type(portée): description » (feat, fix, perf, docs, refactor, test, build, ci, chore, style, i18n)."
        echo "             Ce commit ne comptera pas pour le calcul automatique de la version (scripts/release.sh)."
    } >&2
fi
exit 0
