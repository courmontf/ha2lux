#!/usr/bin/env bash
# Before each commit: formatting, clippy, leaks, large files. Fast (a few seconds).
# Exceptional bypass: git commit --no-verify  (the online CI re-checks everything).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
export PATH="$HOME/.cargo/bin:$PATH"

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
[ "${#staged[@]}" -gt 0 ] || exit 0

echo "[pre-commit] fichiers interdits et taille" >&2
for f in "${staged[@]}"; do
    case "$f" in
        target/*|*/target/*|*.pem|*.key|.env|*.env)
            echo "refusé : $f ne doit pas être commité" >&2; exit 1 ;;
    esac
    if [ -f "$f" ] && [ "$(wc -c < "$f")" -gt 1048576 ]; then
        echo "refusé : $f dépasse 1 Mo" >&2; exit 1
    fi
done

echo "[pre-commit] scan de fuites" >&2
scripts/check-secrets.sh "${staged[@]}"

if printf '%s\n' "${staged[@]}" | grep -qE '\.rs$|(^|/)Cargo\.(toml|lock)$'; then
    echo "[pre-commit] cargo fmt --check" >&2
    cargo fmt --check
    echo "[pre-commit] cargo clippy" >&2
    cargo clippy --workspace --all-targets -- -D warnings
fi
