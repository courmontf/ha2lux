# ha2lux: gives the active session's user access to the DDC/CI buses (/dev/i2c-*).
#
# Install it YOURSELF (ha2lux never modifies /etc):
#   sudo install -m 0644 packaging/udev/60-ha2lux-i2c.rules /etc/udev/rules.d/
#   sudo udevadm control --reload
#   sudo udevadm trigger --subsystem-match=i2c-dev
#
# "uaccess" grants an ACL to the user of the active graphical session (no group to
# manage). The number 60 is lower than 73 (73-seat-late.rules), which is required for
# the tag to be taken into account. Alternative without uaccess: an "i2c" group
#   KERNEL=="i2c-[0-9]*", GROUP="i2c", MODE="0660"
# then `sudo usermod -aG i2c "$USER"` and log out and back in.
SUBSYSTEM=="i2c-dev", KERNEL=="i2c-[0-9]*", TAG+="uaccess"
