# D-Bus activation: the first call to org.ha2lux.Daemon (CLI, tray) starts the systemd unit.
# Install it yourself, e.g.: install -Dm644 packaging/dbus/org.ha2lux.Daemon.service \
#   ~/.local/share/dbus-1/services/org.ha2lux.Daemon.service
[D-BUS Service]
Name=org.ha2lux.Daemon
Exec=/bin/false
SystemdService=ha2luxd.service
