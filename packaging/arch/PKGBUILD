# UNTESTED: Arch Linux package skeleton. Validate on an Arch machine before any use.
pkgname=ha2lux
pkgver=0.8.0
pkgrel=1
pkgdesc="Brightness control for all displays (DDC/CI, backlight) — daemon, CLI and tray icon"
arch=('x86_64' 'aarch64')
url="https://example.invalid/ha2lux"   # to be filled in
license=('MIT')
depends=('dbus' 'i2c-tools')
makedepends=('cargo')
optdepends=('pipewire: microphone/camera detection for idle dimming'
            'libsecret: keyring for the Home Assistant token')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/ha2luxd "$pkgdir/usr/bin/ha2luxd"
  install -Dm755 target/release/ha2lux "$pkgdir/usr/bin/ha2lux"
  install -Dm755 target/release/ha2lux-tray "$pkgdir/usr/bin/ha2lux-tray"
  install -Dm644 packaging/systemd/ha2luxd.service "$pkgdir/usr/lib/systemd/user/ha2luxd.service"
  install -Dm644 packaging/dbus/org.ha2lux.Daemon.service "$pkgdir/usr/share/dbus-1/services/org.ha2lux.Daemon.service"
  install -Dm644 packaging/udev/60-ha2lux-i2c.rules "$pkgdir/usr/lib/udev/rules.d/60-ha2lux-i2c.rules"
  install -Dm644 packaging/modules-load.d/ha2lux-i2c-dev.conf "$pkgdir/usr/lib/modules-load.d/ha2lux-i2c-dev.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/xdg/autostart/ha2lux-tray.desktop "$pkgdir/etc/xdg/autostart/ha2lux-tray.desktop"
}
